# Site-wide security settings.

# No folder listings.
Options -Indexes

# Security headers: no framing by other sites (clickjacking), no MIME sniffing,
# and no full URLs leaked to other sites.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Files that are part of the project but must never be downloaded:
# the database schema, docs, Docker files and anything hidden (.git, .env ...).
<FilesMatch "(\.(sql|md|sh|lock|log|ini|bak)|^Dockerfile|^\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)(database|\.git|\.claude)(/|$) - [F,L]
</IfModule>
